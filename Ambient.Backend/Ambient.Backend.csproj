<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup>
		<Title>Ambient Frontend ~ WinForms/WPF Hybrid</Title>
		<Authors>MedwardR</Authors>
		<RepositoryUrl>https://github.com/MedwardR/Ambient/</RepositoryUrl>
